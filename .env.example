# ---- general ----
APP_NAME="Helpdesk API"
ENVIRONMENT=development          # development | production  (production enforces a strong SECRET_KEY, no CORS wildcard)
DEBUG=false
ENABLE_DOCS=true                 # set false in production to hide /docs and /openapi.json

# ---- database ----
# SQLite (zero-setup local dev)
DATABASE_URL=sqlite+aiosqlite:///./helpdesk.db
# PostgreSQL (production / docker compose)
# DATABASE_URL=postgresql+asyncpg://helpdesk:helpdesk@localhost:5432/helpdesk
AUTO_CREATE_TABLES=false         # keep false: create the schema with `alembic upgrade head`

# ---- auth ----
SECRET_KEY=change-me             # python -c "import secrets; print(secrets.token_hex(32))"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- logging ----
LOG_LEVEL=INFO
LOG_JSON=false                   # false = readable console output locally; true = JSON lines for log aggregators

# ---- HTTP hardening ----
CORS_ORIGINS=                    # comma-separated, e.g. https://helpdesk.example.com  (empty = CORS off)
ALLOWED_HOSTS=*                  # production example: helpdesk.example.com,localhost

# ---- rate limiting ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=memory://            # redis://localhost:6379/0 when running several workers
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=10/hour
RATE_LIMIT_CREATE_TICKET=30/minute

# ---- login throttling ----
LOGIN_MAX_ATTEMPTS=5             # failed logins from ONE IP against ONE email before that pair is refused
LOCKOUT_MINUTES=15
ACCOUNT_FAILURE_ALERT=50         # failures for one email from ALL IPs per window -> warning log + slower attempts (0 = off)
ACCOUNT_FAILURE_WINDOW_MINUTES=60
ACCOUNT_FAILURE_DELAY_SECONDS=2

# ---- behind a reverse proxy (read by uvicorn, not by the app) ----
# FORWARDED_ALLOW_IPS=10.0.0.5   # the proxy's address; uvicorn then trusts its X-Forwarded-For header
